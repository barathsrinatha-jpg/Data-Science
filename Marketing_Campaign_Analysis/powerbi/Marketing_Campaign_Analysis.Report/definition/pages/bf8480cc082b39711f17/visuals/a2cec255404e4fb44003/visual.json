              {
                "textRuns": [
                  {
                    "value": "Business Recommendations",
                    "textStyle": {
                      "fontSize": "18pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1.  Target the best profile first. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "High-income customers without children, aged 45 and over, respond at 26% to 28% against 14.8% on average.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2.  Lead premium and wine offers with high earners. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "They spend 1,038 per customer, 62% above the overall average of 640.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3.  Re-engage the 16,765 under-served browsers. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Offer web-exclusive discounts and bundles: they visit 7.2 times a month but spend only 130.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4.  Serve high-value customers through store and catalog first. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "They average 5.9 store and 3.0 catalog purchases; use web as the secondary channel.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5.  Weight campaign budget towards Australia and India, and fix Spain. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Response is 20.2% and 18.8% there against 12.9% in Spain and 11.6% in Canada.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "6.  Repeat what worked. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Reuse the offer and creative of Campaign 1 and the latest campaign, and review Campaigns 2 to 5 before running them again.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              }
            ]
