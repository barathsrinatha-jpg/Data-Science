  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Insights",
                    "textStyle": {
                      "fontSize": "18pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Income is the strongest driver of response. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Customers earning over 75,000 respond at 23.5%, against 14.8% overall and only 5.1% for incomes up to 30,000.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Households without children respond almost twice as often. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "21.5% versus 11.6% for families; responders have 0.7 children on average against 0.9 for non-responders.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Response rises with age. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "From 11.6% for under-30s to 18.6% for customers aged 60+. The best profile (high income, no children, 60+) reaches 27.8%, 1.9 times the average.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Campaigns performed very unevenly. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Campaign 1 (13.4%) and the latest campaign (14.8%) far outperformed Campaigns 2 to 5 (1.4% to 6.2%).",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Spend is concentrated. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Meat and wines make up 80% of spend and the top 10% of customers generate 31% of it. High earners spend 1,038 per customer against 640 overall.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ High-value customers buy in store and online, not by browsing. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "They make 5.9 store and 5.2 web purchases each but visit the website 4.3 times a month, against 6.2 visits for low-value customers.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ A large under-served group exists. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "16,765 customers (29.9%) browse the website often, spend below the median and did not respond. They earn about 32,300 on average.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "▪ Markets differ. ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold",
                      "color": "#1F3864"
                    }
                  },
                  {
                    "value": "Spain is the largest market (29.8% of customers) but responds below average (12.9%). Australia leads on response (20.2%) and spend per customer (827).",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "5pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
