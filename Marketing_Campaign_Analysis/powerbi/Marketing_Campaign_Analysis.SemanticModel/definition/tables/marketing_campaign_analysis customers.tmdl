table 'marketing_campaign_analysis customers'
	lineageTag: 0242d8fe-f917-4b15-932e-860f73a7b6a1

	measure 'Total Customers' =
			
			COUNT('marketing_campaign_analysis customers'[ID])
		formatString: 0
		lineageTag: 44b66b73-32a9-4ded-999b-344476be5098

	measure 'Total Responders' =
			
			SUM('marketing_campaign_analysis customers'[Response])
		formatString: 0
		lineageTag: 44e75e72-27c4-4498-b82f-76d2e4c8db64

	measure 'Campaign Response Rate' =
			
			DIVIDE(
			    [Total Responders],
			    [Total Customers],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a1752050-6285-420b-9b35-53f5e64e1658

	measure 'Average Income' =
			
			AVERAGE('marketing_campaign_analysis customers'[Income])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b146ac52-5c7f-4e39-951c-42f03da00966

	measure 'Total Spend' =
			
			SUM('marketing_campaign_analysis customers'[Total_Spend])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: b7762d48-0b76-4b72-8bf7-6893bf2b422f

	measure 'Average Spend' =
			
			AVERAGE('marketing_campaign_analysis customers'[Total_Spend])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: b2d32912-5fe0-4b02-8149-d9743ba65e60

	measure 'Total Purchases' =
			
			SUM('marketing_campaign_analysis customers'[Total_Purchases])
		formatString: 0
		lineageTag: 672a3bdd-6afc-460a-a8c2-c5d6843a8391

	measure 'Average Purchases' =
			
			AVERAGE('marketing_campaign_analysis customers'[Total_Purchases])
		lineageTag: 7301cfa4-b425-4a99-8336-acf0bf52c2fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Web Visits' =
			
			AVERAGE('marketing_campaign_analysis customers'[NumWebVisitsMonth])
		lineageTag: 6dcc2e94-ddc5-4e02-b254-592a25e3d77d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Value Customers' =
			
			CALCULATE(
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    'marketing_campaign_analysis customers'[Customer_Value] = "High Value"
			)
		formatString: 0
		lineageTag: 0f3d7a83-4061-4c6b-83ac-b0c45a21e251

	measure 'High Income Customers' =
			
			CALCULATE(
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    'marketing_campaign_analysis customers'[High_Income] = "Yes"
			)
		formatString: 0
		lineageTag: c70ea104-c4bf-444c-b304-0893e7a68607

	measure 'High Spenders' =
			
			CALCULATE(
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    'marketing_campaign_analysis customers'[High_Spender] = "Yes"
			)
		formatString: 0
		lineageTag: c19d4ce8-88cd-4502-bd46-fa83bd7880eb

	measure 'Family Customers' =
			
			CALCULATE(
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    'marketing_campaign_analysis customers'[Family_Customer] = "Yes"
			)
		formatString: 0
		lineageTag: 36c0fe1b-8008-4f90-84d2-387f5d2adbbb

	measure 'Campaign Responders' =
			
			CALCULATE(
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    'marketing_campaign_analysis customers'[Campaign_Responder] = "Yes"
			)
		formatString: 0
		lineageTag: f40ab0c9-e13a-4273-a37f-3c0b9b07aa9e

	measure 'Average Customer Age' =
			
			AVERAGE('marketing_campaign_analysis customers'[Age])
		formatString: 0.0
		lineageTag: 269307c4-c4bb-4525-b78e-47bdd0979357

	measure 'Response Rate' =
			
			DIVIDE(
			    SUM('marketing_campaign_analysis customers'[Response]),
			    COUNT('marketing_campaign_analysis customers'[ID]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6a4a9eba-81a4-40a4-a7e6-d67ff404a26c

	/// Customers with below-median total spend, more than 5 web visits a month and no response to the latest campaign (same rule as the Python and SQL analysis).
	measure 'Under-Served Customers' =
			VAR medianSpend = CALCULATE(MEDIAN('marketing_campaign_analysis customers'[Total_Spend]), ALL('marketing_campaign_analysis customers'))
			RETURN CALCULATE([Total Customers], 'marketing_campaign_analysis customers'[Response] = 0, 'marketing_campaign_analysis customers'[High_Web_Engagement] = "Yes", 'marketing_campaign_analysis customers'[Total_Spend] < medianSpend)
		formatString: #,0
		lineageTag: bf6c5d32-ed5d-47d4-8e41-c92cff2b4f70

	/// Customers under 30 (Young Customer segment).
	measure 'Young Customers' = CALCULATE([Total Customers], 'marketing_campaign_analysis customers'[Young_Customer] = "Yes")
		formatString: #,0
		lineageTag: a2bf3980-2118-4e60-b47b-6bfca39d6da1

	/// Purchases per customer. Use with Channel Purchases[Purchase Channel] on the axis.
	measure 'Avg Purchases per Customer' = DIVIDE(SUM('Channel Purchases'[Purchase Count]), [Total Customers])
		formatString: 0.00
		lineageTag: d0905eb3-4cde-45a9-80f7-a4473d49f2ac

	/// Spend per customer. Use with Product Spend[Product Category].
	measure 'Avg Spend per Customer by Product' = DIVIDE(SUM('Product Spend'[Amount Spent]), [Total Customers])
		formatString: #,0.0
		lineageTag: 732ad255-dc5b-4ee1-ace7-760afa31637b

	/// Average website visits per month.
	measure 'Average Web Visits per Month' = AVERAGE('marketing_campaign_analysis customers'[NumWebVisitsMonth])
		formatString: 0.0
		lineageTag: 296bed06-7015-4652-b1d2-a2b74d01119e

	/// Acceptance rate of the campaign on the axis. Use with Campaigns[Campaign].
	measure 'Campaign Acceptance Rate' =
			VAR c = SELECTEDVALUE(Campaigns[Campaign])
			RETURN SWITCH(c,
			    "Campaign 1", AVERAGE('marketing_campaign_analysis customers'[AcceptedCmp1]),
			    "Campaign 2", AVERAGE('marketing_campaign_analysis customers'[AcceptedCmp2]),
			    "Campaign 3", AVERAGE('marketing_campaign_analysis customers'[AcceptedCmp3]),
			    "Campaign 4", AVERAGE('marketing_campaign_analysis customers'[AcceptedCmp4]),
			    "Campaign 5", AVERAGE('marketing_campaign_analysis customers'[AcceptedCmp5]),
			    "Latest campaign (Response)", AVERAGE('marketing_campaign_analysis customers'[Response]),
			    BLANK())
		formatString: 0.0%
		lineageTag: b9912cb6-febf-4575-b8c7-691346944cff

	/// Response rate of the segment on the axis. Use with Segments[Segment].
	measure 'Segment Response Rate' =
			VAR s = SELECTEDVALUE(Segments[Segment])
			RETURN SWITCH(s,
			    "High Income (>75k)", CALCULATE([Response Rate], 'marketing_campaign_analysis customers'[High_Income] = "Yes"),
			    "Young (<30)", CALCULATE([Response Rate], 'marketing_campaign_analysis customers'[Young_Customer] = "Yes"),
			    "High Web Engagement (>5 visits)", CALCULATE([Response Rate], 'marketing_campaign_analysis customers'[High_Web_Engagement] = "Yes"),
			    "Family (children)", CALCULATE([Response Rate], 'marketing_campaign_analysis customers'[Family_Customer] = "Yes"),
			    "High Spender (top 10%)", CALCULATE([Response Rate], 'marketing_campaign_analysis customers'[High_Spender] = "Yes"),
			    BLANK())
		formatString: 0.0%
		lineageTag: cc95a5a6-72b6-4c26-aea0-4f8c19da94ab

	/// Number of customers in the segment on the axis. Use with Segments[Segment].
	measure 'Segment Customers' =
			VAR s = SELECTEDVALUE(Segments[Segment])
			RETURN SWITCH(s,
			    "High Income (>75k)", [High Income Customers],
			    "Young (<30)", [Young Customers],
			    "High Web Engagement (>5 visits)", CALCULATE([Total Customers], 'marketing_campaign_analysis customers'[High_Web_Engagement] = "Yes"),
			    "Family (children)", [Family Customers],
			    "High Spender (top 10%)", [High Spenders],
			    BLANK())
		formatString: #,0
		lineageTag: 73c7ebf8-3cc9-490f-9fc3-b00a4a26545e

