	column Age_Group_Order = SWITCH(TRUE(), 'marketing_campaign_analysis customers'[Age] < 30, 1, 'marketing_campaign_analysis customers'[Age] < 45, 2, 'marketing_campaign_analysis customers'[Age] < 60, 3, 4)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0381fbe1-34b3-4a46-882e-70c1e38b9302
		summarizeBy: none

	column Income_Group_Order = SWITCH(TRUE(), 'marketing_campaign_analysis customers'[Income] <= 30000, 1, 'marketing_campaign_analysis customers'[Income] <= 60000, 2, 'marketing_campaign_analysis customers'[Income] <= 75000, 3, 4)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c56f0f07-42bb-4011-9400-93976cbaf0ca
		summarizeBy: none

	partition 'marketing_campaign_analysis customers' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost:3306", "marketing_campaign_analysis"),
				    Customers = Source{[Schema = "marketing_campaign_analysis", Item = "customers"]}[Data]
				in
				    Customers

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

