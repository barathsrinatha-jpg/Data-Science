/// One row per customer and purchase channel (the four Num*Purchases columns unpivoted). Related to customers by ID.
table 'Channel Purchases'
	lineageTag: 425c28f4-9126-4bfe-8023-cc0652ab1c15

	column ID
		dataType: int64
		formatString: 0
		lineageTag: e11f3a0f-4afb-4791-aa66-504c81bd8db6
		summarizeBy: none
		sourceColumn: ID

	column 'Purchase Channel'
		dataType: string
		lineageTag: 9833aa0b-89b1-418a-82f7-0b4232b45bcc
		summarizeBy: none
		sourceColumn: Purchase Channel

	column 'Purchase Count'
		dataType: int64
		formatString: 0
		lineageTag: 02884d3b-2c66-4f50-8136-022644d5c600
		summarizeBy: sum
		sourceColumn: Purchase Count

	partition 'Channel Purchases' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost:3306", "marketing_campaign_analysis"),
				    Customers = Source{[Schema = "marketing_campaign_analysis", Item = "customers"]}[Data],
				    Selected = Table.SelectColumns(Customers, {"ID", "NumWebPurchases", "NumCatalogPurchases", "NumStorePurchases", "NumDealsPurchases"}),
				    Unpivoted = Table.UnpivotOtherColumns(Selected, {"ID"}, "Purchase Channel", "Purchase Count"),
				    Renamed = Table.TransformColumns(Unpivoted, {{"Purchase Channel", each if _ = "NumWebPurchases" then "Web" else if _ = "NumCatalogPurchases" then "Catalog" else if _ = "NumStorePurchases" then "Store" else if _ = "NumDealsPurchases" then "Deals" else _, type text}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"ID", Int64.Type}, {"Purchase Count", Int64.Type}})
				in
				    Typed

