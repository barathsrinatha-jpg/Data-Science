/// Helper table: the five rule-based customer segments, so their response rates can be charted side by side.
table Segments
	lineageTag: bcb88de5-62b4-4530-87b6-4b5826ff317f

	column Segment
		lineageTag: e31a447c-a20e-448c-a150-2531b1de497a
		isNameInferred
		sourceColumn: [Segment]
		sortByColumn: 'Segment Order'

	column 'Segment Order'
		lineageTag: a91a2228-15da-4ad4-9ac2-1048c9ab8c70
		isNameInferred
		sourceColumn: [Segment Order]

	partition Segments = calculated
		mode: import
		source = DATATABLE("Segment", STRING, "Segment Order", INTEGER, {{"High Income (>75k)", 1}, {"Young (<30)", 2}, {"High Web Engagement (>5 visits)", 3}, {"Family (children)", 4}, {"High Spender (top 10%)", 5}})

