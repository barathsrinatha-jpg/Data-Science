/// One row per customer and product category (the six Mnt* spend columns unpivoted). Related to customers by ID.
table 'Product Spend'
	lineageTag: 94c21509-7f1b-45e4-a7f4-517b3098b4b5

	column ID
		dataType: int64
		formatString: 0
		lineageTag: 514c7c68-d263-4dbe-8c9e-b8ec91696474
		summarizeBy: none
		sourceColumn: ID

	column 'Product Category'
		dataType: string
		lineageTag: 275ac6e0-3bb3-43cf-b5a4-ea18331c7fcb
		summarizeBy: none
		sourceColumn: Product Category

	column 'Amount Spent'
		dataType: int64
		formatString: 0
		lineageTag: 75767adc-04aa-48b0-9c03-e386b3fef509
		summarizeBy: sum
		sourceColumn: Amount Spent

	partition 'Product Spend' = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost:3306", "marketing_campaign_analysis"),
				    Customers = Source{[Schema = "marketing_campaign_analysis", Item = "customers"]}[Data],
				    Selected = Table.SelectColumns(Customers, {"ID", "MntWines", "MntFruits", "MntMeatProducts", "MntFishProducts", "MntSweetProducts", "MntGoldProds"}),
				    Unpivoted = Table.UnpivotOtherColumns(Selected, {"ID"}, "Product Category", "Amount Spent"),
				    Renamed = Table.TransformColumns(Unpivoted, {{"Product Category", each if _ = "MntWines" then "Wines" else if _ = "MntFruits" then "Fruits" else if _ = "MntMeatProducts" then "Meat" else if _ = "MntFishProducts" then "Fish" else if _ = "MntSweetProducts" then "Sweets" else if _ = "MntGoldProds" then "Gold" else _, type text}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"ID", Int64.Type}, {"Amount Spent", Int64.Type}})
				in
				    Typed

