/// Helper table: one row per campaign, so campaign acceptance rates can be charted side by side.
table Campaigns
	lineageTag: ffb9ca26-3523-4ada-9309-129cac2cae9a

	column Campaign
		lineageTag: b438b519-6064-4e89-9f30-967a253b86ff
		isNameInferred
		sourceColumn: [Campaign]
		sortByColumn: 'Campaign Order'

	column 'Campaign Order'
		lineageTag: dcc038c5-ef50-4435-89c6-d90af9a39257
		isNameInferred
		sourceColumn: [Campaign Order]

	partition Campaigns = calculated
		mode: import
		source = DATATABLE("Campaign", STRING, "Campaign Order", INTEGER, {{"Campaign 1", 1}, {"Campaign 2", 2}, {"Campaign 3", 3}, {"Campaign 4", 4}, {"Campaign 5", 5}, {"Latest campaign (Response)", 6}})

